{
  "name": "focus-agent-frontend-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "contract:check": "make contract-check",
    "lint-strict": "make lint-strict",
    "sdk:build": "pnpm --filter @focus-agent/web-sdk build",
    "sdk:check": "pnpm --filter @focus-agent/web-sdk check",
    "sdk:validate:transport": "pnpm --filter @focus-agent/web-sdk validate:transport",
    "web:dev": "pnpm --filter @focus-agent/web-app dev",
    "web:build": "pnpm --filter @focus-agent/web-app build",
    "web:check": "pnpm --filter @focus-agent/web-app check",
    "web:style:check": "pnpm --filter @focus-agent/web-app style:check",
    "web:a11y:baseline": "pnpm --filter @focus-agent/web-app a11y:baseline",
    "web:visual:baseline": "pnpm --filter @focus-agent/web-app visual:baseline",
    "web:lint:full": "pnpm --filter @focus-agent/web-app lint:full",
    "web:format": "pnpm --filter @focus-agent/web-app format",
    "web:format:check": "pnpm --filter @focus-agent/web-app format:check",
    "web:format:check:full": "pnpm --filter @focus-agent/web-app format:check:full",
    "android:web:build": "VITE_FOCUS_AGENT_TARGET=android VITE_FOCUS_AGENT_APP_BASE=/ VITE_FOCUS_AGENT_ROUTER_BASE=/ VITE_FOCUS_AGENT_ENABLE_AGENT_WORKBENCH=false VITE_FOCUS_AGENT_ENABLE_PRODUCTIVITY=false pnpm web:build",
    "android:sync": "pnpm android:web:build && pnpm exec cap sync android",
    "android:open": "pnpm exec cap open android",
    "android:run": "pnpm android:sync && pnpm exec cap run android",
    "android:apk:debug": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:runtime:smoke": "pnpm --filter @focus-agent/web-app smoke:android-local-runtime",
    "frontend:qa": "make frontend-qa",
    "frontend:visual:qa": "make frontend-visual-qa",
    "compat:report": "make compat-report",
    "test:thread-stream-frontend-regressions": "node --test tests/test_thread_stream_frontend_regressions.mjs",
    "check": "pnpm lint-strict && pnpm contract:check && pnpm sdk:check && pnpm sdk:validate:transport && pnpm web:style:check && pnpm web:lint:full && pnpm web:format:check:full && pnpm web:check && pnpm test:thread-stream-frontend-regressions",
    "build": "pnpm sdk:build && pnpm web:build",
    "ci": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@capacitor/android": "8.3.4",
    "@capacitor/core": "8.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.4"
  }
}
