# Copy this file to:
# .focus_agent/local.env
#
# That local file is git-ignored, so it stays on your machine and does not get pushed.
#
# Use this file for local credentials and provider endpoints only.
# Model selection, helper_model, provider metadata, and the visible model list live in:
# .focus_agent/models.toml
#
# Built-in tool enablement and runtime limits live in:
# .focus_agent/tools.toml
#
# Generated artifacts default to:
# .focus_agent/artifacts/
# Override with ARTIFACT_DIR only when you intentionally want a different local output path.
#
# Process environment variables still win over this file.
# You can override the file path with FOCUS_AGENT_LOCAL_ENV_FILE.
#
# Leave DATABASE_URI unset when you use the local startup commands (`make api`,
# `make dev`, `make serve`, `make serve-dev`, or `make serve-prod`). They manage
# a local PostgreSQL for you,
# inject DATABASE_URI into the API process automatically, stop it when the service
# exits, and keep the repo-local Postgres data directory for the next run.
# That auto-managed path requires PostgreSQL tools like `initdb`, `pg_ctl`,
# `createdb`, and `psql` to be available on your PATH.
# Set DATABASE_URI only when you intentionally want to use an existing PostgreSQL;
# explicit DATABASE_URI values are preserved and not replaced by local startup.
#
# Runtime coordination defaults are local-first. Thread turn locks use a TTL so
# abandoned turns eventually unblock. Background jobs use in-memory coordination
# unless BACKGROUND_JOB_BACKEND=postgres is explicitly set with DATABASE_URI.
# RUNTIME_THREAD_LOCK_TTL_SECONDS=300
# RUNTIME_THREAD_LOCK_HEARTBEAT_SECONDS=30
# BACKGROUND_WORKER_MAX_CONCURRENCY=2
# BACKGROUND_QUEUE_MAX_SIZE=1000
# BACKGROUND_JOB_BACKEND=memory
# BACKGROUND_JOB_EXECUTION=best_effort
# BACKGROUND_JOB_CLAIM_TTL_SECONDS=300

# Chat provider paths can use Ollama's OpenAI-compatible /v1 endpoint. Memory
# embedding auto mode strips the /v1 suffix and calls native Ollama /api/tags
# and /api/embed for embeddinggemma.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me-locally
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=replace-me-locally
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=replace-me-locally
TAVILY_API_KEY=replace-me-locally
TEMPERATURE=0

# Agent role routing is preview-first and disabled by default.
# Executor falls back to MODEL / .focus_agent/models.toml default; planning,
# critique, memory, and skill roles fall back to HELPER_MODEL when unset.
# AGENT_ROLE_ROUTING_ENABLED=false
# AGENT_ROLE_MAX_PARALLEL_RUNS=3
# AGENT_ROLE_ORCHESTRATOR_MODEL=
# AGENT_ROLE_PLANNER_MODEL=
# AGENT_ROLE_EXECUTOR_MODEL=
# AGENT_ROLE_CRITIC_MODEL=
# AGENT_ROLE_MEMORY_MODEL=
# AGENT_ROLE_SKILL_MODEL=

# Skill runtime is local-first. Bundled skills remain available by default;
# optional local/project skills can be installed under .focus_agent/skills or
# another directory listed in FOCUS_AGENT_SKILLS_DIRS. The Admin settings center
# writes these values when global or per-skill enablement changes.
# FOCUS_AGENT_SKILLS_ENABLED=true
# FOCUS_AGENT_SKILLS_DIRS=.focus_agent/skills
# SKILL_INSTALL_DIRECTORY=.focus_agent/skills
# SKILL_DISABLED_IDS=
# SKILL_SEMANTIC_MATCH_ENABLED=true
# SKILL_SEMANTIC_MATCH_THRESHOLD=0.22

# Agent governance automation is feature-flagged.
# AGENT_MEMORY_CURATOR_ENABLED=false
# AGENT_MEMORY_AUTO_PROMOTE_ON_MERGE=true
# Branch decisions are evidence-first by default. Post-turn decisions can record
# split/conclude/merge-candidate evidence; pre-turn recommendations can suggest
# child/sibling branches. Recommendation suggest mode only creates a pending
# Branch Action card and still requires user confirmation before fork/navigation.
# AGENT_BRANCH_DECISION_ENABLED=false
# AGENT_BRANCH_DECISION_MODE=shadow
# AGENT_BRANCH_DECISION_MIN_CONFIDENCE=0.70
# AGENT_BRANCH_DECISION_SPLIT_THRESHOLD=0.65
# AGENT_BRANCH_DECISION_CONCLUDE_THRESHOLD=0.70
# AGENT_BRANCH_DECISION_MERGE_CANDIDATE_THRESHOLD=0.75
# AGENT_BRANCH_DECISION_RATE_LIMIT_PER_HOUR=3
# AGENT_BRANCH_RECOMMENDATION_ENABLED=false
# AGENT_BRANCH_RECOMMENDATION_MODE=shadow
# AGENT_BRANCH_RECOMMENDATION_MIN_CONFIDENCE=0.72
# Semantic recommendation classification only judges whether the next user
# message is related to current branch history; it does not affect answer
# generation. When unset, enabled follows AGENT_BRANCH_RECOMMENDATION_ENABLED.
# AGENT_BRANCH_RECOMMENDATION_SEMANTIC_ENABLED=false
# AGENT_BRANCH_RECOMMENDATION_SEMANTIC_MODEL=

# PostgreSQL pgvector memory embedding is enabled by default.
# Local/test runs may auto-create the `vector` extension when the connected
# PostgreSQL role has permission. Production should preinstall it and use
# AGENT_MEMORY_PGVECTOR_EXTENSION_MODE=required.
# Local auto mode prefers Ollama embeddinggemma. Install explicitly with:
#   ollama pull embeddinggemma
# AGENT_MEMORY_EMBEDDING_ENABLED=true
# AGENT_MEMORY_EMBEDDING_BACKEND=auto
# AGENT_MEMORY_EMBEDDING_MODEL=embeddinggemma
# AGENT_MEMORY_EMBEDDING_DIMENSIONS=768
# Set these for a cloud/OpenAI-compatible embedding endpoint.
# AGENT_MEMORY_EMBEDDING_BACKEND=openai_compatible
# AGENT_MEMORY_EMBEDDING_PROVIDER=openai_compatible
# AGENT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_MEMORY_EMBEDDING_DIMENSIONS=1536
# AGENT_MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AGENT_MEMORY_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# AGENT_MEMORY_EMBEDDING_API_KEY=
# AGENT_MEMORY_EMBEDDING_BATCH_SIZE=32
# AGENT_MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
# AGENT_MEMORY_VECTOR_SEARCH_MODE=hybrid
# AGENT_MEMORY_PGVECTOR_EXTENSION_MODE=auto_create
# AGENT_MEMORY_VECTOR_INDEX_ENABLED=false
# AGENT_MEMORY_POSTGRES_TRIGRAM_ENABLED=false
# AGENT_MEMORY_APPROVAL_FOR_SHARED_WRITES=false
# To disable embedding and pgvector table creation in a local run:
# AGENT_MEMORY_EMBEDDING_ENABLED=false
# AGENT_MEMORY_EMBEDDING_BACKEND=disabled
# AGENT_MEMORY_VECTOR_SEARCH_MODE=off

# AGENT_TOOL_ROUTER_ENABLED=false
# AGENT_TOOL_ROUTER_ENFORCE=true
# AGENT_DELEGATION_ENABLED=false
# AGENT_DELEGATION_ENFORCE=false
# AGENT_DELEGATION_EXECUTION_MODE=observe
# AGENT_MODEL_ROUTER_ENABLED=false
# AGENT_MODEL_ROUTER_MODE=observe
# AGENT_SELF_REPAIR_ENABLED=false
# AGENT_REVIEW_QUEUE_ENABLED=false
# AGENT_CONTEXT_ENGINEERING_V2_ENABLED=false
# AGENT_CONTEXT_ARTIFACTIZE_LONG_OBSERVATIONS=false
# AGENT_CONTEXT_ROLE_VIEWS_ENABLED=false
# AGENT_CONTEXT_TOKENIZER_MODE=chars_fallback
# AGENT_CONTEXT_ARTIFACT_MIN_CHARS=12000
# CONTEXT_AUTO_COMPACTION_ENABLED=true
# CONTEXT_AUTO_COMPACTION_PRE_SEND_RATIO=0.92
# CONTEXT_AUTO_COMPACTION_POST_TURN_RATIO=0.85
# AGENT_TASK_LEDGER_ENABLED=false
# AGENT_ARTIFACT_SYNTHESIS_ENABLED=false
# AGENT_CRITIC_GATE_ENABLED=false
# AGENT_CRITIC_GATE_ENFORCE=false

# ARTIFACT_DIR=.focus_agent/artifacts
# DATABASE_URI=postgresql://user:pass@host:5432/focus_agent
# WEB_APP_DEV_SERVER_URL=http://127.0.0.1:5173/app
