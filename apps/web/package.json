{
  "name": "@focus-agent/web-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "pnpm dlx @biomejs/biome@2.2.4 lint src/entities src/features/trajectory-observability",
    "lint:full": "pnpm dlx @biomejs/biome@2.2.4 lint src",
    "format": "pnpm run format:write",
    "format:write": "pnpm dlx @biomejs/biome@2.2.4 format --write src/entities src/features/trajectory-observability",
    "format:check": "pnpm dlx @biomejs/biome@2.2.4 format src/entities src/features/trajectory-observability",
    "format:check:full": "pnpm dlx @biomejs/biome@2.2.4 format src",
    "smoke:observability": "node ./scripts/observability-smoke.mjs",
    "smoke:productivity": "node ./scripts/productivity-smoke.mjs",
    "smoke:agent-team-adoption": "node ./scripts/agent-team-adoption-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@focus-agent/web-sdk": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0"
  }
}
