# Core model selection. Requires the matching provider integration package.
MODEL=openai:gpt-4.1-mini
TEMPERATURE=0
# Bound each upstream model request so a stalled provider cannot hold a chat SSE stream forever.
MODEL_REQUEST_TIMEOUT_SECONDS=120

# Optional: LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=focus-agent

# Optional: durable short-term memory, PostgreSQL canonical memory, Zvec retrieval, and pgvector fallback.
# Local make commands manage a repo-local PostgreSQL when DATABASE_URI is unset.
# Uncomment and export this example only when you intentionally want to point the
# raw process or Docker Compose at an existing database.
# DATABASE_URI=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable
#
# The raw `.venv/bin/focus-agent-api` command does not start managed Postgres.
# Without DATABASE_URI it persists app state in BRANCH_DB_PATH and uses SQLite
# checkpoints/store under the same directory; it is not an in-memory-only mode.

# Zvec is the default rebuildable retrieval index. PostgreSQL and the
# filesystem remain canonical stores; pgvector settings below are compatibility
# and fallback settings.
AGENT_RETRIEVAL_BACKEND=zvec
AGENT_RETRIEVAL_FALLBACK_BACKEND=postgres
AGENT_ZVEC_ENABLED=true
AGENT_ZVEC_DATA_DIR=.focus_agent/zvec

# Memory embedding is enabled by default for Postgres-backed runs.
# Test/local environments may allow the app migration to create the extension.
# Production should preinstall `vector` with a privileged migration role and set
# AGENT_MEMORY_PGVECTOR_EXTENSION_MODE=required when pgvector fallback is used.
# Local auto mode prefers Ollama embeddinggemma. Local DEV startup enables
# auto-pull by default, and you can still install explicitly with:
#   ollama pull embeddinggemma
AGENT_MEMORY_EMBEDDING_ENABLED=true
AGENT_MEMORY_EMBEDDING_BACKEND=auto
AGENT_MEMORY_EMBEDDING_MODEL=embeddinggemma
AGENT_MEMORY_EMBEDDING_DIMENSIONS=768
AGENT_MEMORY_EMBEDDING_AUTO_PULL=true
AGENT_MEMORY_EMBEDDING_PULL_TIMEOUT_SECONDS=300
# Set these explicitly for a cloud/OpenAI-compatible embedding endpoint.
# AGENT_MEMORY_EMBEDDING_BACKEND=openai_compatible
# AGENT_MEMORY_EMBEDDING_PROVIDER=openai_compatible
# AGENT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_MEMORY_EMBEDDING_DIMENSIONS=1536
# AGENT_MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AGENT_MEMORY_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# AGENT_MEMORY_EMBEDDING_API_KEY=
AGENT_MEMORY_EMBEDDING_BATCH_SIZE=32
AGENT_MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
AGENT_MEMORY_VECTOR_SEARCH_MODE=hybrid
AGENT_MEMORY_PGVECTOR_EXTENSION_MODE=auto_create
AGENT_MEMORY_VECTOR_INDEX_ENABLED=false
AGENT_MEMORY_POSTGRES_TRIGRAM_ENABLED=false
AGENT_MEMORY_APPROVAL_FOR_SHARED_WRITES=false
# To disable embedding and pgvector table creation in a local run:
# AGENT_MEMORY_EMBEDDING_ENABLED=false
# AGENT_MEMORY_EMBEDDING_BACKEND=disabled
# AGENT_MEMORY_VECTOR_SEARCH_MODE=off

# Runtime coordination. Background jobs use local in-memory coordination by
# default; set BACKGROUND_JOB_BACKEND=postgres only when DATABASE_URI points at
# a shared Postgres and you want durable job claim/status/attempt metadata.
RUNTIME_THREAD_LOCK_TTL_SECONDS=300
RUNTIME_THREAD_LOCK_HEARTBEAT_SECONDS=30
BACKGROUND_WORKER_MAX_CONCURRENCY=2
BACKGROUND_QUEUE_MAX_SIZE=1000
BACKGROUND_JOB_BACKEND=memory
BACKGROUND_JOB_EXECUTION=best_effort
BACKGROUND_JOB_CLAIM_TTL_SECONDS=300

# Performance rollout flags. Defaults match production-safe behavior after
# perf-p1/perf-p2. To roll back one subsystem, set its flag to the documented
# off value and restart the API process.
FOCUS_AGENT_DB_POOL_ENABLED=true
FOCUS_AGENT_DB_POOL_MAX=20
FOCUS_AGENT_CHECKPOINT_INCREMENTAL=true
FOCUS_AGENT_CHECKPOINT_BACKEND=sqlite
FOCUS_AGENT_MEMORY_EMBED_ASYNC=true
FOCUS_AGENT_TOOL_POOL_ISOLATED=true

# SQLite is the safe local default for both LangGraph checkpoints and the local
# store. Defaults are `.focus_agent/langgraph-checkpoints.sqlite3` and
# `.focus_agent/langgraph-store.sqlite3` when BRANCH_DB_PATH keeps its default.
# If you explicitly select `pickle`, signature verification is on by default
# and a stable per-environment HMAC key is required before startup. Missing or
# invalid signatures, missing keys, unreadable files, and owner mismatches fail
# closed. Disable verification only for a bounded, isolated legacy migration.
FOCUS_AGENT_CHECKPOINT_VERIFY_SIGNATURE=true
FOCUS_AGENT_CHECKPOINT_HMAC_KEY=

# Optional: Agent Server / LangSmith Deployment URL.
# When set, BranchService prefers exact thread copy through the server API.
LANGGRAPH_API_URL=http://localhost:2024

# Local branch lineage metadata store
BRANCH_DB_PATH=.focus_agent/branches.sqlite3

# Artifact output directory for the demo tool
ARTIFACT_DIR=.focus_agent/artifacts

# Authentication defaults for local development only.
# Disable demo token issuance and use a strong secret in any shared or public environment.
AUTH_ENABLED=true
AUTH_DEMO_TOKENS_ENABLED=true
AUTH_JWT_SECRET=dev-only-local-jwt-secret-rotate-32chars
AUTH_JWT_ISSUER=focus-agent
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
# Non-development environments fail startup unless Secure cookies are enabled
# and SameSite is `lax` or `strict`. Cookie-authenticated POST/PUT/PATCH/DELETE
# requests are CSRF-protected; valid Bearer-authenticated mutations are exempt.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# CORS. Leave empty to disable the CORS middleware (same-origin only).
# Provide a comma-separated list of allowed origins for cross-origin browser clients.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# Rate limiting. Disabled by default; enable in shared environments.
# Chat endpoints (which trigger LLM calls) use the stricter chat-specific limit.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# Agent delegation defaults.
AGENT_DELEGATION_EXECUTION_MODE=observe

# Agent Team v2 coordination is default-off. Enabling the workbench UI is not
# equivalent to enabling this runtime, and normal chat does not auto-enter it.
# These controls are separate from MULTI_AGENT_*: the default kill switch keeps
# execution stopped. `/v2/agent-team/readiness` combines configured/runtime
# prerequisites with required service capabilities; `ready=true` still requires
# separate execution evidence before any release claim. See
# docs/agent-team-v2-rollout.md before changing shared settings.
AGENT_TEAM_V2_ENABLED=false
AGENT_TEAM_ROLLOUT_PHASE=off
AGENT_TEAM_EXECUTION_MODE=disabled
AGENT_TEAM_REAL_PROVIDER_ENABLED=false
AGENT_TEAM_DURABLE_REQUIRED=false
AGENT_TEAM_FENCING_ENABLED=false
AGENT_TEAM_CROSS_SESSION_LOCKS_ENABLED=false
AGENT_TEAM_APPROVAL_RESUME_ENABLED=false
AGENT_TEAM_KILL_SWITCH_ENABLED=true
AGENT_TEAM_LEGACY_WRITE_ENABLED=false
MULTI_AGENT_V2_ENABLED=false
MULTI_AGENT_DAG_SCHEDULER_ENABLED=false
MULTI_AGENT_RESOURCE_LOCK_ENABLED=false
MULTI_AGENT_MESSAGE_BUS_ENABLED=false
MULTI_AGENT_ASYNC_APPROVAL_ENABLED=false
MULTI_AGENT_FAILURE_HANDLER_ENABLED=false
MULTI_AGENT_RESOURCE_LOCK_TTL_SECONDS=60
MULTI_AGENT_RESOURCE_LOCK_HEARTBEAT_SECONDS=15
MULTI_AGENT_MESSAGE_TTL_SECONDS=300
MULTI_AGENT_APPROVAL_TIMEOUT_SECONDS=60
MULTI_AGENT_DEADLOCK_CHECK_INTERVAL_SECONDS=30
# MULTI_AGENT_ROLE_FALLBACK_MODELS={"planner":"openai:gpt-4.1-mini"}

# Sandbox defaults for local development. `auto` may visibly fall back to local
# host execution; it is not Docker-isolation evidence. Shared/production-like
# Agent Team command execution must use `docker` with fallback disabled. Real
# mode also requires the durable Postgres/job/worker/coordination prerequisites;
# Postgres persists v2 execution records, while the repository without
# DATABASE_URI is an in-memory fallback. Approval-resume adapters are not
# restart recovery.
FOCUS_AGENT_SANDBOX_BACKEND=auto
FOCUS_AGENT_SANDBOX_ALLOW_LOCAL_FALLBACK=1
# FOCUS_AGENT_SANDBOX_IMAGE=focus-agent-sandbox:latest

# Skill runtime defaults. Prefer editing these through the Admin settings center
# for local runs; keep local skill directories and disabled ids out of tracked
# source unless they are intentionally part of a deployment template.
FOCUS_AGENT_SKILLS_ENABLED=true
FOCUS_AGENT_SKILLS_DIRS=.focus_agent/skills
SKILL_INSTALL_DIRECTORY=.focus_agent/skills
SKILL_DISABLED_IDS=
SKILL_SEMANTIC_MATCH_ENABLED=true
SKILL_SEMANTIC_MATCH_THRESHOLD=0.22
