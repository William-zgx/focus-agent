# Core model selection. Requires the matching provider integration package.
MODEL=openai:gpt-4.1-mini
TEMPERATURE=0

# Optional: LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=focus-agent

# Optional: durable short-term memory, PostgreSQL canonical memory, and pgvector.
# Local make commands manage a repo-local PostgreSQL when DATABASE_URI is unset.
# Uncomment and export this example only when you intentionally want to point the
# raw process or Docker Compose at an existing database.
# DATABASE_URI=postgresql://postgres:postgres@localhost:5442/postgres?sslmode=disable

# PostgreSQL pgvector memory embedding is enabled by default.
# Test/local environments may allow the app migration to create the extension.
# Production should preinstall `vector` with a privileged migration role and set
# AGENT_MEMORY_PGVECTOR_EXTENSION_MODE=required for app-role startup checks.
# Local auto mode prefers Ollama embeddinggemma. Install explicitly with:
#   ollama pull embeddinggemma
AGENT_MEMORY_EMBEDDING_ENABLED=true
AGENT_MEMORY_EMBEDDING_BACKEND=auto
AGENT_MEMORY_EMBEDDING_MODEL=embeddinggemma
AGENT_MEMORY_EMBEDDING_DIMENSIONS=768
# Set these explicitly for a cloud/OpenAI-compatible embedding endpoint.
# AGENT_MEMORY_EMBEDDING_BACKEND=openai_compatible
# AGENT_MEMORY_EMBEDDING_PROVIDER=openai_compatible
# AGENT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_MEMORY_EMBEDDING_DIMENSIONS=1536
# AGENT_MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AGENT_MEMORY_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# AGENT_MEMORY_EMBEDDING_API_KEY=
AGENT_MEMORY_EMBEDDING_BATCH_SIZE=32
AGENT_MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
AGENT_MEMORY_VECTOR_SEARCH_MODE=hybrid
AGENT_MEMORY_PGVECTOR_EXTENSION_MODE=auto_create
AGENT_MEMORY_VECTOR_INDEX_ENABLED=false
AGENT_MEMORY_POSTGRES_TRIGRAM_ENABLED=false
AGENT_MEMORY_APPROVAL_FOR_SHARED_WRITES=false
# To disable embedding and pgvector table creation in a local run:
# AGENT_MEMORY_EMBEDDING_ENABLED=false
# AGENT_MEMORY_EMBEDDING_BACKEND=disabled
# AGENT_MEMORY_VECTOR_SEARCH_MODE=off

# Runtime coordination. Background jobs use local in-memory coordination by
# default; set BACKGROUND_JOB_BACKEND=postgres only when DATABASE_URI points at
# a shared Postgres and you want durable job claim/status/attempt metadata.
RUNTIME_THREAD_LOCK_TTL_SECONDS=300
RUNTIME_THREAD_LOCK_HEARTBEAT_SECONDS=30
BACKGROUND_WORKER_MAX_CONCURRENCY=2
BACKGROUND_QUEUE_MAX_SIZE=1000
BACKGROUND_JOB_BACKEND=memory
BACKGROUND_JOB_EXECUTION=best_effort
BACKGROUND_JOB_CLAIM_TTL_SECONDS=300

# Performance rollout flags. Defaults match production-safe behavior after
# perf-p1/perf-p2. To roll back one subsystem, set its flag to the documented
# off value and restart the API process.
FOCUS_AGENT_DB_POOL_ENABLED=true
FOCUS_AGENT_DB_POOL_MAX=20
FOCUS_AGENT_CHECKPOINT_INCREMENTAL=true
FOCUS_AGENT_CHECKPOINT_BACKEND=pickle
FOCUS_AGENT_MEMORY_EMBED_ASYNC=true
FOCUS_AGENT_TOOL_POOL_ISOLATED=true

# Local checkpoint pickle loading is signature-verified by default. Use a
# stable per-environment secret. Temporarily disable verification only to read
# legacy unsigned checkpoint files, then re-enable after they are rewritten.
FOCUS_AGENT_CHECKPOINT_VERIFY_SIGNATURE=true
FOCUS_AGENT_CHECKPOINT_HMAC_KEY=

# Optional: Agent Server / LangSmith Deployment URL.
# When set, BranchService prefers exact thread copy through the server API.
LANGGRAPH_API_URL=http://localhost:2024

# Local branch lineage metadata store
BRANCH_DB_PATH=.focus_agent/branches.sqlite3

# Artifact output directory for the demo tool
ARTIFACT_DIR=.focus_agent/artifacts

# Authentication defaults for local development only.
# Disable demo token issuance and use a strong secret in any shared or public environment.
AUTH_ENABLED=true
AUTH_DEMO_TOKENS_ENABLED=true
AUTH_JWT_SECRET=dev-only-local-jwt-secret-rotate-32chars
AUTH_JWT_ISSUER=focus-agent
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800

# CORS. Leave empty to disable the CORS middleware (same-origin only).
# Provide a comma-separated list of allowed origins for cross-origin browser clients.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# Rate limiting. Disabled by default; enable in shared environments.
# Chat endpoints (which trigger LLM calls) use the stricter chat-specific limit.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# Agent delegation defaults.
AGENT_DELEGATION_EXECUTION_MODE=observe
